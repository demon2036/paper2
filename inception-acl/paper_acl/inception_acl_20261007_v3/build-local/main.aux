\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Existing attacks have limited effectiveness on GPT-Image-2.} Cross-category ASRs reproduced from Table\nobreakspace  {}3 of \citet  {pixjail}. The same eleven methods reach 52.7--96.7\% on SDXL and 0--3.9\% on GPT-Image-2. Panel (a) uses a common 0--100\% scale; panel (b) uses a 0--4\% scale to expose the low-ASR differences. Each row refers to the same method in both panels.\relax }}{4}{figure.caption.7}\protected@file@percent }
\newlabel{fig:baselinecomparison}{{2}{4}{\textbf {Existing attacks have limited effectiveness on GPT-Image-2.} Cross-category ASRs reproduced from Table~3 of \citet {pixjail}. The same eleven methods reach 52.7--96.7\% on SDXL and 0--3.9\% on GPT-Image-2. Panel (a) uses a common 0--100\% scale; panel (b) uses a 0--4\% scale to expose the low-ASR differences. Each row refers to the same method in both panels.\relax }{figure.caption.7}{}}
\newlabel{fig:benchmark}{{2}{4}{\textbf {Existing attacks have limited effectiveness on GPT-Image-2.} Cross-category ASRs reproduced from Table~3 of \citet {pixjail}. The same eleven methods reach 52.7--96.7\% on SDXL and 0--3.9\% on GPT-Image-2. Panel (a) uses a common 0--100\% scale; panel (b) uses a 0--4\% scale to expose the low-ASR differences. Each row refers to the same method in both panels.\relax }{figure.caption.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {Public sexual-content evidence on GPT-Image-2.} Entries describe GPT-Image-2 outputs using Table\nobreakspace  {}\ref  {tab:axes}. ``Not located'' indicates that we found no verifiable public sexual-content output on this model; the corresponding grades are left blank. RISE's redactions prevent exposure grading. PixJail's reproduction scores are reported separately in Figure\nobreakspace  {}\ref  {fig:baselinecomparison}.\relax }}{4}{table.caption.8}\protected@file@percent }
\newlabel{tab:priorprofiles}{{2}{4}{\textbf {Public sexual-content evidence on GPT-Image-2.} Entries describe GPT-Image-2 outputs using Table~\ref {tab:axes}. ``Not located'' indicates that we found no verifiable public sexual-content output on this model; the corresponding grades are left blank. RISE's redactions prevent exposure grading. PixJail's reproduction scores are reported separately in Figure~\ref {fig:baselinecomparison}.\relax }{table.caption.8}{}}
